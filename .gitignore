# Ignore direct root entries, then allow maintained project content.
/*

!/.github/
!/.vscode/
!/docs/
!/scripts/
!/test/
!/src/
!/syntaxes/
!/images/
!/resources/

!/.editorconfig
!/.envrc
!/.gitattributes
!/.gitignore
!/.node-version
!/.npmrc
!/.oxlintrc.json
!/.pre-commit-config.yaml
!/.vscodeignore
!/AGENTS.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/Justfile
!/LICENSE
!/LICENSE.md
!/README.md
!/dprint.json
!/flake.nix
!/flake.lock
!/package.json
!/package-lock.json
!/language-configuration.json
!/tsconfig.json
!/webpack.config.js
!/icon.png

node_modules/
dist/
out/
.direnv/
*.vsix
/.vscode/settings.json
**/.env
**/.env.*
**/var/
