{
  "name": "nostradavid-better-comments",
  "displayName": "Better Comments by NostraDavid",
  "version": "1.0.8",
  "description": "Comment highlighting that distinguishes Python comments from strings. Existing better-comments.* settings remain supported.",
  "categories": [
    "Formatters"
  ],
  "homepage": "https://github.com/NostraDavid/better-comments#readme",
  "bugs": {
    "url": "https://github.com/NostraDavid/better-comments/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NostraDavid/better-comments.git"
  },
  "license": "MIT",
  "author": "NostraDavid",
  "publisher": "nostradavid",
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "test": "npm run compile && node --test test/*.test.mjs",
    "build": "webpack --mode production && node scripts/third-party-notices.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --githubBranch master",
    "release:check": "node scripts/release-notes.mjs",
    "compile": "tsc -p .",
    "type-check": "tsc -p . --noEmit"
  },
  "contributes": {
    "configuration": {
      "title": "Better Comments configuration",
      "properties": {
        "better-comments.multilineComments": {
          "type": "boolean",
          "description": "Whether the multiline comment highlighter should be active",
          "default": true
        },
        "better-comments.highlightPlainText": {
          "type": "boolean",
          "description": "Whether the plaintext comment highlighter should be active",
          "default": false
        },
        "better-comments.tags": {
          "type": "array",
          "description": "Tags used to color comments. Changes take effect immediately.",
          "default": [
            {
              "tag": "!",
              "color": "#FF2D00",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            },
            {
              "tag": "?",
              "color": "#3498DB",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            },
            {
              "tag": "//",
              "color": "#474747",
              "strikethrough": true,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            },
            {
              "tag": "todo",
              "color": "#FF8C00",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            },
            {
              "tag": "*",
              "color": "#98C379",
              "strikethrough": false,
              "underline": false,
              "backgroundColor": "transparent",
              "bold": false,
              "italic": false
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "description": "Comment tag. An empty string matches any real comment."
              },
              "color": {
                "type": "string"
              },
              "backgroundColor": {
                "type": "string"
              },
              "strikethrough": {
                "type": "boolean"
              },
              "underline": {
                "type": "boolean"
              },
              "bold": {
                "type": "boolean"
              },
              "italic": {
                "type": "boolean"
              }
            }
          }
        },
        "better-comments.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "description": "Enable comment highlighting. Can be overridden per language."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0",
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@lezer/javascript": "1.5.6",
    "@lezer/python": "1.1.19",
    "json5": "2.2.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#e3f4ff",
    "theme": "light"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "sponsor": {
    "url": "https://github.com/sponsors/aaron-bond"
  }
}
